// ocr-review/tsconfig.json —— 编译选项全部继承 @jayyuen66/dsh-plugin-shared/config/tsconfig.base.json，这里只留本包与基线不同的部分。
{
  "extends": "@jayyuen66/dsh-plugin-shared/config/tsconfig.base.json",
  // include 是 host 程序的全量清单（TS 的 include 是整体替换，基线没有 include 可合并）。
  "include": [
    "host.ts",
    "lib/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts",
    "oxlint.config.ts",
    "oxfmt.config.ts"
  ],
  // test/client/ 是 client 程序（tsconfig.client.json）的成员：那里是浏览器类型环境
  // （DOM lib、types:[]），host 程序没有 DOM，把它收进来会在 document 一类取用上报
  // TS2304。include 的 test/**/*.ts 若不排除会把该目录抢进 host 程序。目录约定两端
  // 各写一次，新增 client 侧用例放进该目录即自动归位，无需改任何清单。
  "exclude": ["test/client"]
}
